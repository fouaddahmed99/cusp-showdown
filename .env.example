# Live multiplayer. Both values are public by design: the anon key is meant to
# ship to a browser, and every write it can reach is checked server-side against
# a room token. See supabase/schema.sql.
#
# Leave these unset and solo play works; Host and Join show setup instructions.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
